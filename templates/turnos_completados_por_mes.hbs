<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{{titulo}}</title>
    <style>
      body { font-family: Arial, sans-serif; margin: 0; padding: 0; }
      .container { padding: 20px; }
      h1 { font-size: 18px; margin-bottom: 4px; }
      .meta { font-size: 12px; color: #666; margin-bottom: 20px; }
      table { width: 100%; border-collapse: collapse; margin-top: 12px; }
      th, td { border: 1px solid #ddd; padding: 7px 8px; text-align: left; font-size: 12px; }
      th { background: #f4f4f4; font-size: 12px; }
      tbody tr:nth-child(even) { background: #fbfbfb; }
      .totales td { font-weight: bold; background: #f0f0f0; border-top: 2px solid #bbb; }
      .sin-datos { color: #888; font-size: 13px; margin-top: 20px; }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>{{titulo}}</h1>
      <div class="meta">Período: {{fecha}} &nbsp;|&nbsp; {{leyenda}}</div>

      {{#if filas.length}}
      <table>
        <thead>
          <tr>
            <th>Fecha y hora</th>
            <th>Médico</th>
            <th>Especialidad</th>
            <th>Paciente</th>
            <th>Obra social</th>
            <th>Total consulta</th>
          </tr>
        </thead>
        <tbody>
          {{#each filas}}
            <tr>
              <td>{{fecha_hora}}</td>
              <td>{{medico}}</td>
              <td>{{especialidad}}</td>
              <td>{{paciente}}</td>
              <td>{{obra_social}}</td>
              <td>$ {{valor_total}}</td>
            </tr>
          {{/each}}
        </tbody>
        <tfoot>
          <tr class="totales">
            <td colspan="5">Total de turnos: {{totalTurnos}}</td>
            <td>$ {{totalMonto}}</td>
          </tr>
        </tfoot>
      </table>
      {{else}}
        <p class="sin-datos">No se registraron turnos completados para el período seleccionado.</p>
      {{/if}}
    </div>
  </body>
</html>
