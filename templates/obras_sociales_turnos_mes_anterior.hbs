<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{{titulo}}</title>
    <style>
      body { font-family: Arial, sans-serif; margin: 0; padding: 0; }
      .container { padding: 20px; }
      h1 { font-size: 18px; margin-bottom: 4px; }
      .meta { font-size: 12px; color: #666; margin-bottom: 20px; }
      table { width: 100%; border-collapse: collapse; margin-top: 12px; }
      th, td { border: 1px solid #ddd; padding: 7px 8px; text-align: left; font-size: 12px; }
      th { background: #f4f4f4; font-size: 12px; }
      tbody tr:nth-child(even) { background: #fbfbfb; }
      .totales td { font-weight: bold; background: #f0f0f0; border-top: 2px solid #bbb; }
      .sin-datos { color: #888; font-size: 13px; margin-top: 20px; }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  </head>
  <body>
    <div class="container">
      <h1>{{titulo}}</h1>
      <div class="meta">Período: {{fecha}} &nbsp;|&nbsp; {{leyenda}}</div>

      <div style="max-width:900px; height:320px; margin-top:20px;">
        <canvas id="obrasSocialesChart"></canvas>
      </div>

      {{#if filas.length}}
      <table>
        <thead>
          <tr>
            <th>Obra social</th>
            <th>Cantidad de turnos</th>
          </tr>
        </thead>
        <tbody>
          {{#each filas}}
            <tr>
              <td>{{obra_social}}</td>
              <td>{{cantidad_turnos}}</td>
            </tr>
          {{/each}}
        </tbody>
        <tfoot>
          <tr class="totales">
            <td>Total de turnos</td>
            <td>{{totalTurnos}}</td>
          </tr>
        </tfoot>
      </table>
      {{else}}
        <p class="sin-datos">No se registraron turnos para el período seleccionado.</p>
      {{/if}}
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const labels = [{{#each filas}}"{{obra_social}}"{{#unless @last}}, {{/unless}}{{/each}}];
        const dataValues = [{{#each filas}}{{cantidad_turnos}}{{#unless @last}}, {{/unless}}{{/each}}];

        const ctx = document.getElementById('obrasSocialesChart').getContext('2d');
        new Chart(ctx, {
          type: 'bar',
          data: {
            labels: labels,
            datasets: [{
              label: 'Cantidad de turnos',
              data: dataValues,
              backgroundColor: 'rgba(255, 159, 64, 0.6)',
              borderColor: 'rgba(255, 159, 64, 1)',
              borderWidth: 1
            }]
          },
          options: {
            scales: {
              y: { beginAtZero: true, ticks: { precision: 0 } }
            },
            responsive: true,
            maintainAspectRatio: false
          }
        });
      });
    </script>
  </body>
</html>
